{
  "name": "@metamask/snap-simple-keyring-site",
  "version": "2.1.1",
  "description": "A snap simple keyring dapp used in MetaMask e2e tests.",
  "license": "(MIT-0 OR Apache-2.0)",
  "scripts": {
    "build": "yarn clean && cross-env NODE_ENV=production node ./scripts/build.js",
    "clean": "rimraf dist",
    "lint": "yarn lint:eslint && yarn lint:misc && yarn lint:deps && yarn lint:types",
    "lint:deps": "depcheck",
    "lint:eslint": "eslint . --cache --ext js,jsx,ts,tsx",
    "lint:fix": "yarn lint:eslint --fix && yarn lint:misc --write",
    "lint:misc": "prettier '**/*.html' '**/*.json' '**/*.md' '!CHANGELOG.md' --check",
    "lint:types": "tsc --noEmit",
    "start": "cross-env NODE_ENV=development node ./scripts/start.js"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@metamask/keyring-api": "^23.1.0",
    "@metamask/keyring-snap-client": "^9.0.2",
    "@metamask/providers": "^19.0.0",
    "bootstrap": "^5.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@metamask/eslint-config": "^12.2.0",
    "@metamask/eslint-config-jest": "^12.1.0",
    "@metamask/eslint-config-nodejs": "^12.1.0",
    "@metamask/eslint-config-typescript": "^12.1.0",
    "@swc/core": "1.3.78",
    "@types/react": "^18.0.28",
    "@typescript-eslint/eslint-plugin": "^5.55.0",
    "@typescript-eslint/parser": "^5.55.0",
    "cross-env": "^7.0.3",
    "css-loader": "^5.2.7",
    "depcheck": "^1.4.6",
    "eslint": "^8.36.0",
    "eslint-config-prettier": "^8.7.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-jsdoc": "^40.0.3",
    "eslint-plugin-n": "^16.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "html-webpack-plugin": "^5.5.0",
    "prettier": "^2.8.4",
    "rimraf": "^4.4.0",
    "style-loader": "^2.0.0",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^4.9.5",
    "webpack": "^5.88.2",
    "webpack-dev-server": "^4.6.0"
  }
}
